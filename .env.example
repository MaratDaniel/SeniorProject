# Copy to .env (never commit .env) and fill in the secrets.
POSTGRES_PASSWORD=
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ADAL_JWT_SECRET=
# python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ADAL_MFA_ENCRYPTION_KEY=
# dev keeps the email outbox page on (no real email is sent). Use prod with an https origin for a real deployment.
ADAL_ENV=dev
ADAL_FRONTEND_URL=http://localhost:8080
ADAL_COOKIE_SECURE=false
