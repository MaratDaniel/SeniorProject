# Copy to .env (never commit .env) and fill in the secrets.
POSTGRES_PASSWORD=
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ADAL_JWT_SECRET=
# python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ADAL_MFA_ENCRYPTION_KEY=
# dev keeps the email outbox page on. Use prod with an HTTPS origin for a real deployment.
ADAL_ENV=dev
ADAL_FRONTEND_URL=http://localhost:8080
ADAL_COOKIE_SECURE=false

# Optional Resend worker (docker compose --profile email up --build).
# Sign in at https://resend.com/signup if you need an account.
# Open https://resend.com/api-keys, choose Create API Key, and select Sending access.
# Copy the key into your local .env or deployment secrets.
ADAL_RESEND_API_KEY=
ADAL_MAIL_FROM="Adal <onboarding@resend.dev>"
# With the default test sender, enter the email address you use to sign in to Resend.
# Register with that same address in Adal to receive the verification link in your inbox.
# For the development mailbox only, leave the API key and test recipient blank and omit --profile email.
ADAL_MAIL_TEST_RECIPIENT=
