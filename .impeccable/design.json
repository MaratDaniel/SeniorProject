  "narrative": {
    "northStar": "The Level Beam",
    "overview": "Adal means fair and honest, and the system makes fairness visible as balance. The mark is two identical weights on a level beam, balanced on a fulcrum with a single clay point where it rests. The rest of the system behaves the same way: calm stone ground, quiet type, one primary action, and a bidding desk that gives every bidder the same facts in the same place.",
    "keyCharacteristics": [
      "Cool paper ground, sage moss for action, brass used sparingly for what needs attention.",
      "Real photographs lead; dark moss-grain fields frame the cover, hero and winning moment.",
      "Bricolage Grotesque Light for headlines with one brass word; Instrument Sans for everything read; tabular figures for every number.",
      "Soft 10px and 16px corners, 1px rules, one faint layered shadow on the bidding desk only.",
      "Every status is a word plus an icon."
    ],
    "rules": [
      {
        "name": "The One Brass Rule",
        "body": "Brass is for the balance point, Outbid and Ending soon. It is never a button, a decoration or a large field.",
        "section": "colors"
      },
      {
        "name": "The Words Beat Color Rule",
        "body": "Status is a word plus an icon; color is never the only signal.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every number uses tabular figures so a ticking value never shifts its neighbors.",
        "section": "typography"
      },
      {
        "name": "The One Raised Object Rule",
        "body": "Only the bidding desk is lifted. Everything else sits on the page.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do write the closing time out beside every countdown.",
      "Do lead with large, real photography in even, low light.",
      "Do keep one primary action per view, in moss.",
      "Do keep the beam level and the weights identical in the mark; let it settle once on first appearance.",
      "Do credit photographs that need it."
    ],
    "donts": [
      "Don't add gold, bright accents, gradients on text, or hard shadows.",
      "Don't use brass for buttons or large areas.",
      "Don't tilt the beam, make the weights differ, or recolor the balance point.",
      "Don't use exclamation marks, emoji or hype wording.",
      "Don't put a second raised object on the page."
    ]
  }
